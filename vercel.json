{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "generated",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.getlawscope.com"
        }
      ],
      "destination": "https://getlawscope.com/:path*",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/dashboard/",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/.netlify/identity",
      "destination": "/api/cms-gateway?path=/.netlify/identity"
    },
    {
      "source": "/.netlify/identity/",
      "destination": "/api/cms-gateway?path=/.netlify/identity"
    },
    {
      "source": "/.netlify/identity/settings",
      "destination": "/api/cms-gateway?path=/.netlify/identity/settings"
    },
    {
      "source": "/.netlify/identity/settings/",
      "destination": "/api/cms-gateway?path=/.netlify/identity/settings"
    },
    {
      "source": "/.netlify/identity/token",
      "destination": "/api/cms-gateway?path=/.netlify/identity/token"
    },
    {
      "source": "/.netlify/identity/token/",
      "destination": "/api/cms-gateway?path=/.netlify/identity/token"
    },
    {
      "source": "/.netlify/identity/user",
      "destination": "/api/cms-gateway?path=/.netlify/identity/user"
    },
    {
      "source": "/.netlify/identity/user/",
      "destination": "/api/cms-gateway?path=/.netlify/identity/user"
    },
    {
      "source": "/.netlify/identity/logout",
      "destination": "/api/cms-gateway?path=/.netlify/identity/logout"
    },
    {
      "source": "/.netlify/identity/logout/",
      "destination": "/api/cms-gateway?path=/.netlify/identity/logout"
    },
    {
      "source": "/.netlify/identity/recover",
      "destination": "/api/cms-gateway?path=/.netlify/identity/recover"
    },
    {
      "source": "/.netlify/identity/recover/",
      "destination": "/api/cms-gateway?path=/.netlify/identity/recover"
    },
    {
      "source": "/.netlify/identity/verify",
      "destination": "/api/cms-gateway?path=/.netlify/identity/verify"
    },
    {
      "source": "/.netlify/identity/verify/",
      "destination": "/api/cms-gateway?path=/.netlify/identity/verify"
    },
    {
      "source": "/.netlify/identity/signup",
      "destination": "/api/cms-gateway?path=/.netlify/identity/signup"
    },
    {
      "source": "/.netlify/identity/signup/",
      "destination": "/api/cms-gateway?path=/.netlify/identity/signup"
    },
    {
      "source": "/.netlify/identity/confirm",
      "destination": "/api/cms-gateway?path=/.netlify/identity/confirm"
    },
    {
      "source": "/.netlify/identity/confirm/",
      "destination": "/api/cms-gateway?path=/.netlify/identity/confirm"
    },
    {
      "source": "/.netlify/git",
      "destination": "/api/cms-gateway?path=/.netlify/git"
    },
    {
      "source": "/.netlify/git/",
      "destination": "/api/cms-gateway?path=/.netlify/git"
    },
    {
      "source": "/.netlify/git/settings",
      "destination": "/api/cms-gateway?path=/.netlify/git/settings"
    },
    {
      "source": "/.netlify/git/settings/",
      "destination": "/api/cms-gateway?path=/.netlify/git/settings"
    },
    {
      "source": "/.netlify/:path*",
      "destination": "/api/cms-proxy/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.+\\.)?vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
        }
      ]
    }
  ]
}
