# Copy this file to .env for local development only.
# Never commit .env or secret API keys.

# Public site configuration
SITE_URL=http://localhost:4173

# Public HTTPS origin of the owner-approved Netlify companion project used only
# for Identity and Git Gateway. Origin only: no path, credentials, query,
# fragment, or trailing slash. The build derives both service endpoints. Leave
# empty to keep /admin/ safely unprovisioned. Scope Preview values to one
# explicitly approved branch; never use a wildcard origin.
# Example: https://lawscope-cms.netlify.app
CMS_COMPANION_ORIGIN=

# Public identifiers. These placeholders do not activate tracking or ads.
# GA4 also requires VERCEL_ENV=production, GA4_ENABLED=true, a real ID, and
# affirmative analytics consent before the Google tag can be requested.
GA4_ENABLED=false
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# Use only for a controlled DebugView test; never leave enabled routinely.
GA4_DEBUG_MODE=false
# AdSense activation is Production-only and fails closed unless all readiness
# attestations and every approved public identifier are present. The local
# preference center is not a Google-certified CMP. Keep these inert defaults
# until the Module 31 owner/policy/CMP checklist is complete.
ADSENSE_ENABLED=false
ADSENSE_ACCOUNT_APPROVED=false
ADSENSE_POLICY_REVIEWED=false
ADSENSE_CERTIFIED_CMP_READY=false
ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000
ADSENSE_SLOT_HOME_BELOW_FEATURED=0000000000
ADSENSE_SLOT_ARTICLES_IN_FEED=0000000000
ADSENSE_SLOT_CATEGORIES_OVERVIEW=0000000000
ADSENSE_SLOT_CATEGORY_IN_FEED=0000000000
ADSENSE_SLOT_ARTICLE_MID=0000000000
ADSENSE_SLOT_ARTICLE_SIDEBAR=0000000000
ADSENSE_SLOT_ARTICLE_END=0000000000

# Public form endpoints only. Secret provider keys belong in Vercel settings.
NEWSLETTER_FORM_ENDPOINT=
# Approved values: generic-form or generic-json
NEWSLETTER_PROVIDER=generic-form
# Public same-origin contact settings. Keep false until delivery is monitored.
CONTACT_FORM_ENABLED=false
CONTACT_FORM_ENDPOINT=/api/contact/

# Server-only contact delivery values. Configure real values in encrypted
# Vercel environment settings; never expose them to browser code.
CONTACT_DELIVERY_WEBHOOK_URL=
CONTACT_DELIVERY_WEBHOOK_TOKEN=
CONTACT_RATE_LIMIT_SECRET=
CONTACT_ALLOWED_ORIGINS=

# Privacy Policy publication approval. This toggle alone is insufficient:
# versioned counsel, legal-identity, provider/retention, and monitored-channel
# confirmations must also pass before a production build becomes indexable.
PRIVACY_POLICY_APPROVED=false

# Long-form Legal Disclaimer approval. Keep false until qualified counsel has
# approved the versioned full-page language and review_status is approved.
LEGAL_DISCLAIMER_APPROVED=false
